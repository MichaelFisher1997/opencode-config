{
  "$schema": "https://opencode.ai/config.json",
  "model": "zhipuai-coding-plan/glm-5.3",
  "agents": {
    "title": {
      "model": "openai/gpt-5.6-luna-fast"
    }
  },
  "instructions": [
    "rules/package-manager.md",
    "rules/solid.md"
  ],
  "share": "manual",
  "update": "auto",
  "snapshots": true,
  "plugins": [
    "./plugins/codex-identity"
  ],
  "watcher": {
    "ignore": [
      ".git",
      ".git/**",
      "node_modules/**",
      "worktree/**",
      ".local/share/opencode/worktree/**",
      ".local/share/opencode/snapshot/**",
      ".local/share/opencode/tool-output/**",
      "zig-cache/**",
      ".zig-cache/**",
      "target/**",
      "dist/**",
      "build/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/worktree/**",
      "**/.local/share/opencode/worktree/**",
      "**/.local/share/opencode/snapshot/**",
      "**/.local/share/opencode/tool-output/**",
      "**/zig-cache/**",
      "**/.zig-cache/**",
      "**/target/**",
      "**/dist/**",
      "**/build/**"
    ]
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr comment *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr edit *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue create *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue comment *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue edit *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue close *", "effect": "ask" },
    // { "action": "shell", "resource": "git branch *", "effect": "ask" },
    // { "action": "shell", "resource": "git checkout -b *", "effect": "ask" },
    { "action": "shell", "resource": "git switch -c *", "effect": "ask" },
    { "action": "shell", "resource": "opencode run *", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      }
    }
  },
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      { "action": "provider.use", "resource": "openai", "effect": "allow" },
      { "action": "provider.use", "resource": "zhipuai-coding-plan", "effect": "allow" },
      { "action": "provider.use", "resource": "opencode", "effect": "allow" },
      { "action": "provider.use", "resource": "opencode-go", "effect": "allow" }
    ]
  }
}
