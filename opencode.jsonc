{
  "$schema": "https://opencode.ai/config.json",
  "model": "zhipuai-coding-plan/glm-5.2",
  "small_model": "openai/gpt-5.6-luna-fast",
  "instructions": [
    "rules/package-manager.md",
    "rules/solid.md"
  ],
  "autoshare": false,
  "autoupdate": true,
  "snapshot": true,
  "plugin": [
    "./opencode-codex-identity-plugin.ts"
  ],
  "watcher": {
    "ignore": [
      ".git",
      ".git/**",
      "node_modules/**",
      "worktree/**",
      ".local/share/opencode/worktree/**",
      ".local/share/opencode/snapshot/**",
      ".local/share/opencode/tool-output/**",
      "zig-cache/**",
      ".zig-cache/**",
      "target/**",
      "dist/**",
      "build/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/worktree/**",
      "**/.local/share/opencode/worktree/**",
      "**/.local/share/opencode/snapshot/**",
      "**/.local/share/opencode/tool-output/**",
      "**/zig-cache/**",
      "**/.zig-cache/**",
      "**/target/**",
      "**/dist/**",
      "**/build/**"
    ]
  },
  "permission": {
    "bash": {
      "gh pr create *": "ask",
      "gh pr comment *": "ask",
      "gh pr edit *": "ask",
      "gh issue create *": "ask",
      "gh issue comment *": "ask",
      "gh issue edit *": "ask",
      "gh issue close *": "ask",
      //"git branch *": "ask",
      //"git checkout -b *": "ask",
      "git switch -c *": "ask"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "provider": {
    "vercel": {
      "name": "Vercel AI Gateway",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["AI_GATEWAY_API_KEY"],
      "options": {
        "baseURL": "https://ai-gateway.vercel.sh/v1"
      },
      "models": {
        "meta/muse-spark-1.2-contributor": {
          "id": "meta/muse-spark-1.2-contributor",
          "name": "Muse Spark 1.2 Contributor",
          "family": "muse",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 1048576
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "cost": {
            "input": 0.10,
            "output": 0.20,
            "cache_read": 0.002
          }
        }
      }
    }
  }
}
